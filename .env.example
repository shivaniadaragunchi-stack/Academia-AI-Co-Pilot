# Mock-first local demo. No API keys, paid-service credentials, or network access are required.
# In mock mode, the API client returns local mock responses and session/transcript data comes
# from in-repository fixtures. It makes no fetch/axios API requests. The mock microphone is
# simulated and never records audio. A local dev server still serves the app's static assets.
VITE_API_CLIENT_MODE=mock
VITE_API_MOCK_SCENARIO=success

# Optional backend integration (not used by the default mock mode):
# Set VITE_API_CLIENT_MODE=http and VITE_API_BASE_URL only when a backend is ready.
# HTTP mode uses fetch to call that configured backend; do not set it for an offline demo.
